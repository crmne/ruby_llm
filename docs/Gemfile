source 'https://rubygems.org'

gem 'jekyll'
gem 'webrick'

# The 2.0 docs use the VitePress theme. just-the-docs stays because
# bin/build-versions.sh builds the frozen 1.x docs with this same Gemfile,
# and that tree is still on just-the-docs.
gem 'jekyll-vitepress-theme'
gem 'just-the-docs'

# GitHub Pages plugins
group :jekyll_plugins do
  gem 'jekyll-remote-theme'
  gem 'jekyll-seo-tag'
  gem 'jekyll-sitemap'
  gem 'jekyll-og-image'
  gem 'jekyll-redirect-from'
  gem 'jekyll-ai-visible-content',
      git: 'https://github.com/crmne/jekyll-ai-visible-content.git',
      branch: 'include-custom-collections-in-llms'
end
