source 'https://rubygems.org'

gem 'jekyll'
gem 'webrick'

# The 2.0 docs use the VitePress theme. just-the-docs stays because
# bin/build-versions.sh builds the frozen 1.x docs with this same Gemfile,
# and that tree is still on just-the-docs.
gem 'jekyll-vitepress-theme'
gem 'just-the-docs'

# The frozen 1.x docs still use jekyll-seo-tag in their archived layout. Keep
# it installed outside :jekyll_plugins so the current theme-native docs do not
# auto-load it.
gem 'jekyll-seo-tag'

# GitHub Pages plugins
group :jekyll_plugins do
  gem 'jekyll-remote-theme'
  gem 'jekyll-og-image'
  gem 'jekyll-redirect-from'
end
