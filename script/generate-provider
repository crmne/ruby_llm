#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'ruby_llm/provider_generator/cli'

begin
  name, options = RubyLLM::ProviderGenerator::CLI.parse_options(ARGV, mode: 'core')
rescue RubyLLM::ProviderGenerator::CLI::HelpRequested => e
  puts e.message
  exit 0
end
result = RubyLLM::ProviderGenerator::Scaffold.new(name, **options).generate

puts "Generated #{result.changed.size} core provider changes"
puts "Skipped #{result.skipped.size} existing files" if result.skipped.any?
