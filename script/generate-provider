#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'generators/ruby_llm/provider/cli'

begin
  name, options = RubyLLM::Generators::Provider::CLI.parse_options(ARGV, mode: 'core')
rescue RubyLLM::Generators::Provider::CLI::HelpRequested => e
  puts e.message
  exit 0
end
result = RubyLLM::Generators::Provider::Scaffold.new(name, **options).generate

puts "Generated #{result.changed.size} core provider changes"
puts "Skipped #{result.skipped.size} existing files" if result.skipped.any?
