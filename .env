# 1Password lookups only, never values: dotenv runs each $(...) when the specs,
# rake tasks, or bin/console load this file. A lookup that fails leaves its key
# empty, which the specs treat as unset, so its cassettes replay.
ANTHROPIC_API_KEY=$(op-cache read "op://RubyLLM/Anthropic/credential")
AWS_ACCESS_KEY_ID=$(op-cache read "op://RubyLLM/AWS/key id")
AWS_REGION=$(op-cache read "op://RubyLLM/AWS/region")
AWS_SECRET_ACCESS_KEY=$(op-cache read "op://RubyLLM/AWS/access key")
AZURE_API_BASE=$(op-cache read "op://RubyLLM/Azure/endpoint")
AZURE_API_KEY=$(op-cache read "op://RubyLLM/Azure/credential")
# CODECOV_TOKEN=$(op-cache read "op://RubyLLM/Codecov/credential")
COHERE_API_KEY=$(op-cache read "op://RubyLLM/Cohere/credential")
# The RubyLLM vault has no Deepgram item yet. Add one, then uncomment this.
# DEEPGRAM_API_KEY=$(op-cache read "op://RubyLLM/Deepgram/credential")
DEEPSEEK_API_KEY=$(op-cache read "op://RubyLLM/DeepSeek/credential")
ELEVENLABS_API_KEY=$(op-cache read "op://RubyLLM/Elevenlabs/credential")
GEMINI_API_KEY=$(op-cache read "op://RubyLLM/Gemini/credential")
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=$(op-cache read "op://RubyLLM/Google Cloud/project")
GPUSTACK_API_BASE=http://localhost:11444/v1
GPUSTACK_API_KEY=$(op-cache read "op://RubyLLM/GPUStack/credential")
HETZNER_API_KEY=$(op-cache read "op://RubyLLM/Hetzner Inference/credential")
MINIMAX_API_KEY=$(op-cache read "op://RubyLLM/MiniMax/credential")
MISTRAL_API_KEY=$(op-cache read "op://RubyLLM/Mistral/credential")
MOONSHOT_API_KEY=$(op-cache read "op://RubyLLM/Moonshot/credential")
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_CLOUD_API_KEY=$(op-cache read "op://RubyLLM/Ollama Cloud/credential")
OPENAI_API_KEY=$(op-cache read "op://RubyLLM/OpenAI/credential")
OPENROUTER_API_KEY=$(op-cache read "op://RubyLLM/OpenRouter/credential")
PERPLEXITY_API_KEY=$(op-cache read "op://RubyLLM/Perplexity/credential")
# RUBYLLM_DEBUG=true
# RUBYLLM_LOG_FILE=/tmp/ruby_llm.log
# RUBYLLM_STREAM_DEBUG=true
TYPESAFE_API_KEY=$(op-cache read "op://RubyLLM/TypeSafeAI/credential")
XAI_API_KEY=$(op-cache read "op://RubyLLM/xAI/credential")
ZAI_API_KEY=$(op-cache read "op://RubyLLM/Z.ai/credential")
