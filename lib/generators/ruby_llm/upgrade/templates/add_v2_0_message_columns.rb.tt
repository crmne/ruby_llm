# frozen_string_literal: true

class AddRubyLlmV20Columns < ActiveRecord::Migration<%= migration_version %>
  disable_ddl_transaction!

  LEGACY_TOKEN_COLUMNS = %w[input_tokens output_tokens cache_read_tokens cache_write_tokens thinking_tokens].freeze
  LEGACY_COST_COLUMNS = %w[total_cost cost_details].freeze
  USAGE_PROGRESS_TABLE = :ruby_llm_v2_usage_backfill
  BACKFILL_BATCH_SIZE = 1_000

  def up
    validate_table_moves
    add_chat_and_message_columns
    backfill_legacy_content_raw
    move_models
    move_tool_calls
    move_batches
    create_usage_entries
    backfill_usage_entries
    normalize_usage_indexes
    remove_legacy_message_columns
    drop_usage_progress
  end

  def down
    raise ActiveRecord::IrreversibleMigration,
          'RubyLLM v2 moves application-owned records into RubyLLM-owned tables'
  end

  private

  def with_upgrade_safety(&)
    return safety_assured(&) if respond_to?(:safety_assured, true)

    yield
  end

  def validate_table_moves
    %i[<%= chat_table_name %> <%= message_table_name %>].each do |table|
      raise "Expected #{table} to exist before upgrading RubyLLM" unless table_exists?(table)
    end
    validate_table_shape(:<%= chat_table_name %>, [], 'chat')
    validate_table_shape(
      :<%= message_table_name %>,
      %i[<%= chat_table_name.singularize %>_id role],
      'message'
    )
    if column_exists?(:<%= message_table_name %>, :content_raw) &&
       !column_exists?(:<%= message_table_name %>, :content)
      raise '<%= message_table_name %> has content_raw but no content column to receive it'
    end

    validate_table_move(:<%= legacy_model_table_name %>, :ruby_llm_models)
    validate_table_move(:<%= legacy_tool_call_table_name %>, :ruby_llm_tool_calls)
    models = existing_table(:<%= legacy_model_table_name %>, :ruby_llm_models)
    validate_table_shape(models, %i[model_id name provider], 'model') if models
    validate_unique_values(models, %i[provider model_id]) if models
    validate_chat_model_reference(models) if models

    tool_calls = existing_table(:<%= legacy_tool_call_table_name %>, :ruby_llm_tool_calls)
    if tool_calls
      validate_table_shape(tool_calls, %i[tool_call_id name arguments created_at updated_at], 'tool-call')
      legacy_message_column = :<%= legacy_tool_call_message_foreign_key %>
      unless column_exists?(tool_calls, legacy_message_column) || column_exists?(tool_calls, :message_id)
        raise "#{tool_calls} does not have a message foreign key"
      end
      if migration_record(tool_calls).where(tool_call_id: nil).exists?
        raise "#{tool_calls} contains a NULL tool_call_id. Set it before retrying."
      end
    end

<% if legacy_batch_explicit? -%>
    if table_exists?(:<%= legacy_batch_table_name %>) && !legacy_batch_table?(:<%= legacy_batch_table_name %>)
      raise "<%= legacy_batch_table_name %> does not look like a RubyLLM batch table. Check the batch: mapping."
    end
<% end -%>
    batches = if legacy_batch_table?(:<%= legacy_batch_table_name %>)
                validate_table_move(:<%= legacy_batch_table_name %>, :ruby_llm_batches)
                existing_table(:<%= legacy_batch_table_name %>, :ruby_llm_batches)
              elsif table_exists?(:ruby_llm_batches)
                :ruby_llm_batches
              end
    if batches
      validate_table_shape(
        batches,
        %i[provider_batch_id provider status completed chat_ids created_at updated_at],
        'batch'
      )
      validate_unique_values(batches, %i[provider provider_batch_id])
    end

    if table_exists?(:ruby_llm_usages)
      validate_table_shape(
        :ruby_llm_usages,
        %i[
          chat_type chat_id message_type message_id operation provider model status
          input_tokens output_tokens cache_read_tokens cache_write_tokens thinking_tokens
          input_cost output_cost cache_read_cost cache_write_cost thinking_cost total_cost
          created_at updated_at
        ],
        'usage'
      )
    end
    validate_usage_identities
    return unless table_exists?(USAGE_PROGRESS_TABLE) && !column_exists?(USAGE_PROGRESS_TABLE, :completed)

    raise "#{USAGE_PROGRESS_TABLE} already exists but was not created by this migration"
  end

  def validate_table_move(source, target)
    return if source == target || !table_exists?(source) || !table_exists?(target)

    raise "Both #{source} and #{target} exist. Merge or remove one before running this migration."
  end

  def existing_table(source, target)
    return source if table_exists?(source)

    target if table_exists?(target)
  end

  def validate_table_shape(table, columns, label)
    primary_key = connection.primary_key(table)
    unless primary_key.is_a?(String) && column_exists?(table, primary_key)
      raise "#{table} does not look like a RubyLLM #{label} table; expected one primary key column"
    end

    missing = columns.reject { |column| column_exists?(table, column) }
    return if missing.empty?

    raise "#{table} does not look like a RubyLLM #{label} table; missing columns: #{missing.join(', ')}"
  end

  def validate_unique_values(table, columns)
    duplicates = migration_record(table).group(*columns).having('COUNT(*) > 1').limit(5).pluck(*columns)
    return if duplicates.empty?

    raise "Cannot add a unique index to #{table} on #{columns.join(', ')}; " \
          "duplicate values include #{duplicates.inspect}. Reconcile them before retrying."
  end

  def validate_usage_identities
    models = existing_table(:<%= legacy_model_table_name %>, :ruby_llm_models)
    chat_model_column = if column_exists?(:<%= chat_table_name %>, :<%= legacy_model_foreign_key %>)
                          :<%= legacy_model_foreign_key %>
                        elsif column_exists?(:<%= chat_table_name %>, :ruby_llm_model_id)
                          :ruby_llm_model_id
                        end
    joins, provider, model = usage_identity_sql(models_table: models, chat_model_column: chat_model_column)
    conditions = usage_backfill_conditions(provider, model)
    return if conditions.empty?

    ensure_usage_identities!(conditions, joins, provider, model)
  end

  def validate_chat_model_reference(models)
    chats = :<%= chat_table_name %>
    column_name = if column_exists?(chats, :<%= legacy_model_foreign_key %>)
                    :<%= legacy_model_foreign_key %>
                  elsif column_exists?(chats, :ruby_llm_model_id)
                    :ruby_llm_model_id
                  end
    return unless column_name

    column = connection.columns(chats).find { |candidate| candidate.name == column_name.to_s }
    model_primary_key = connection.primary_key(models)
    model_key_column = connection.columns(models).find { |candidate| candidate.name == model_primary_key }
    unless column.type == model_key_column.type
      raise "Expected #{chats}.#{column_name} to match #{models}.#{model_primary_key}"
    end

    quoted_chats = connection.quote_table_name(chats)
    quoted_models = connection.quote_table_name(models)
    chat_key = connection.quote_column_name(column_name)
    chat_primary_key = connection.quote_column_name(connection.primary_key(chats))
    model_key = connection.quote_column_name(model_primary_key)
    orphan = select_value(<<~SQL)
      SELECT legacy_chats.#{chat_primary_key}
        FROM #{quoted_chats} legacy_chats
        LEFT JOIN #{quoted_models} legacy_models
          ON legacy_chats.#{chat_key} = legacy_models.#{model_key}
       WHERE legacy_chats.#{chat_key} IS NOT NULL
         AND legacy_models.#{model_key} IS NULL
       LIMIT 1
    SQL
    return unless orphan

    raise "Could not find #{models} record for #{chats} id #{orphan}. " \
          'Repair its model reference before retrying.'
  end

  def add_chat_and_message_columns
    add_column :<%= chat_table_name %>, :cancelled, :boolean, null: false, default: false unless column_exists?(:<%= chat_table_name %>, :cancelled)

    with_upgrade_safety do
      change_table :<%= message_table_name %>, bulk: true do |table|
<% if postgresql? -%>
        table.jsonb :citations unless column_exists?(:<%= message_table_name %>, :citations)
        table.jsonb :server_tool_calls unless column_exists?(:<%= message_table_name %>, :server_tool_calls)
        table.jsonb :raw_content unless column_exists?(:<%= message_table_name %>, :raw_content)
        table.jsonb :raw_reasoning unless column_exists?(:<%= message_table_name %>, :raw_reasoning)
<% else -%>
        table.json :citations unless column_exists?(:<%= message_table_name %>, :citations)
        table.json :server_tool_calls unless column_exists?(:<%= message_table_name %>, :server_tool_calls)
        table.json :raw_content unless column_exists?(:<%= message_table_name %>, :raw_content)
        table.json :raw_reasoning unless column_exists?(:<%= message_table_name %>, :raw_reasoning)
<% end -%>
        table.string :finish_reason unless column_exists?(:<%= message_table_name %>, :finish_reason)
        table.boolean :cache_until_here, null: false, default: false unless column_exists?(:<%= message_table_name %>, :cache_until_here)
        if column_exists?(:<%= message_table_name %>, :cached_tokens) &&
           !column_exists?(:<%= message_table_name %>, :cache_read_tokens)
          table.rename :cached_tokens, :cache_read_tokens
        end
        if column_exists?(:<%= message_table_name %>, :cache_creation_tokens) &&
           !column_exists?(:<%= message_table_name %>, :cache_write_tokens)
          table.rename :cache_creation_tokens, :cache_write_tokens
        end
      end
    end
<% if postgresql? -%>
    normalize_postgresql_json_columns(
      :<%= message_table_name %>,
      %i[citations server_tool_calls raw_content raw_reasoning]
    )
<% end -%>
  end

  def backfill_legacy_content_raw
    return unless column_exists?(:<%= message_table_name %>, :content_raw)

    messages = connection.quote_table_name(:<%= message_table_name %>)
    content = connection.quote_column_name(:content)
    content_raw = connection.quote_column_name(:content_raw)
<% if postgresql? -%>
    content_as_json = "#{content_raw}::text"
<% elsif mysql? -%>
    content_as_json = "CAST(#{content_raw} AS CHAR)"
<% else -%>
    content_as_json = content_raw
<% end -%>
    with_upgrade_safety do
      execute <<~SQL
        UPDATE #{messages}
           SET #{content} = #{content_as_json}
         WHERE #{content} IS NULL
           AND #{content_raw} IS NOT NULL
      SQL
    end
  end

  def move_models
    move_table(:<%= legacy_model_table_name %>, :ruby_llm_models) { create_models }
    normalize_model_columns
    normalize_model_indexes
    normalize_chat_model_reference(:<%= chat_table_name %>, :<%= legacy_model_foreign_key %>)
  end

  def normalize_model_columns
<% if postgresql? -%>
    normalize_postgresql_json_columns(:ruby_llm_models, %i[modalities capabilities pricing metadata])
<% end -%>
<% unless mysql? -%>
    normalize_json_defaults(
      :ruby_llm_models,
      modalities: {}, capabilities: [], pricing: {}, metadata: {}
    )
<% end -%>
    with_upgrade_safety do
      change_table :ruby_llm_models, bulk: true do |table|
        table.string :family unless column_exists?(:ruby_llm_models, :family)
        table.datetime :model_created_at unless column_exists?(:ruby_llm_models, :model_created_at)
        table.integer :context_window unless column_exists?(:ruby_llm_models, :context_window)
        table.integer :max_output_tokens unless column_exists?(:ruby_llm_models, :max_output_tokens)
        table.date :knowledge_cutoff unless column_exists?(:ruby_llm_models, :knowledge_cutoff)
        table.datetime :unlisted_at unless column_exists?(:ruby_llm_models, :unlisted_at)
<% if postgresql? -%>
        table.jsonb :modalities, default: {} unless column_exists?(:ruby_llm_models, :modalities)
        table.jsonb :capabilities, default: [] unless column_exists?(:ruby_llm_models, :capabilities)
        table.jsonb :pricing, default: {} unless column_exists?(:ruby_llm_models, :pricing)
        table.jsonb :metadata, default: {} unless column_exists?(:ruby_llm_models, :metadata)
<% elsif mysql? -%>
        table.json :modalities unless column_exists?(:ruby_llm_models, :modalities)
        table.json :capabilities unless column_exists?(:ruby_llm_models, :capabilities)
        table.json :pricing unless column_exists?(:ruby_llm_models, :pricing)
        table.json :metadata unless column_exists?(:ruby_llm_models, :metadata)
<% else -%>
        table.json :modalities, default: {} unless column_exists?(:ruby_llm_models, :modalities)
        table.json :capabilities, default: [] unless column_exists?(:ruby_llm_models, :capabilities)
        table.json :pricing, default: {} unless column_exists?(:ruby_llm_models, :pricing)
        table.json :metadata, default: {} unless column_exists?(:ruby_llm_models, :metadata)
<% end -%>
        table.datetime :created_at unless column_exists?(:ruby_llm_models, :created_at)
        table.datetime :updated_at unless column_exists?(:ruby_llm_models, :updated_at)
      end
    end
  end

<% if postgresql? -%>
  def normalize_postgresql_json_columns(table, columns)
    columns.each do |column_name|
      column = connection.columns(table).find { |candidate| candidate.name == column_name.to_s }
      next unless column&.type == :json

      quoted_column = connection.quote_column_name(column_name)
      with_upgrade_safety do
        change_column table, column_name, :jsonb, using: "#{quoted_column}::jsonb"
      end
    end
  end

<% end -%>
<% unless mysql? -%>
  def normalize_json_defaults(table, defaults)
    defaults.each do |column_name, value|
      column = connection.columns(table).find { |candidate| candidate.name == column_name.to_s }
      next unless column&.default.nil?

      with_upgrade_safety do
        change_column_default table, column_name, from: nil, to: value
      end
    end
  end

<% end -%>
  def create_models
    create_table :ruby_llm_models do |t|
      t.string :model_id, null: false
      t.string :name, null: false
      t.string :provider, null: false
      t.string :family
      t.datetime :model_created_at
      t.integer :context_window
      t.integer :max_output_tokens
      t.date :knowledge_cutoff
      t.datetime :unlisted_at
<% if postgresql? %>
      t.jsonb :modalities, default: {}
      t.jsonb :capabilities, default: []
      t.jsonb :pricing, default: {}
      t.jsonb :metadata, default: {}
<% elsif mysql? %>
      t.json :modalities
      t.json :capabilities
      t.json :pricing
      t.json :metadata
<% else %>
      t.json :modalities, default: {}
      t.json :capabilities, default: []
      t.json :pricing, default: {}
      t.json :metadata, default: {}
<% end %>
      t.timestamps
      t.index %i[provider model_id], unique: true
      t.index :provider
      t.index :family
<% if postgresql? -%>
      t.index :capabilities, using: :gin
      t.index :modalities, using: :gin
<% end -%>
    end
  end

  def normalize_model_indexes
    ensure_unique_index(:ruby_llm_models, %i[provider model_id])
    add_upgrade_index :ruby_llm_models, :provider unless valid_index_exists?(:ruby_llm_models, :provider)
    add_upgrade_index :ruby_llm_models, :family unless valid_index_exists?(:ruby_llm_models, :family)
<% if postgresql? -%>
    ensure_index_method(:ruby_llm_models, :capabilities, using: :gin)
    ensure_index_method(:ruby_llm_models, :modalities, using: :gin)
<% end -%>
  end

  def normalize_chat_model_reference(table, legacy_column)
    column_name = if column_exists?(table, legacy_column)
                    legacy_column
                  elsif column_exists?(table, :ruby_llm_model_id)
                    :ruby_llm_model_id
                  end
    return unless column_name

    column = connection.columns(table).find { |candidate| candidate.name == column_name.to_s }
    model_primary_key = connection.primary_key(:ruby_llm_models)
    model_key_column = connection.columns(:ruby_llm_models).find { |candidate| candidate.name == model_primary_key }
    unless column.type == model_key_column.type
      raise "Expected #{table}.#{column_name} to match ruby_llm_models.#{model_primary_key}"
    end

    if column_name != :ruby_llm_model_id
      with_upgrade_safety { rename_column table, column_name, :ruby_llm_model_id }
    end

    add_upgrade_index table, :ruby_llm_model_id unless valid_index_exists?(table, :ruby_llm_model_id)
    return if foreign_key_exists?(table, :ruby_llm_models, column: :ruby_llm_model_id)

    add_upgrade_foreign_key table, :ruby_llm_models, column: :ruby_llm_model_id
  end

  def move_tool_calls
    move_table(:<%= legacy_tool_call_table_name %>, :ruby_llm_tool_calls) { create_tool_calls }
    normalize_tool_calls
  end

  def create_tool_calls
    create_table :ruby_llm_tool_calls do |t|
      t.references :message, polymorphic: true, null: false,
                             type: reference_type_for(:<%= message_table_name %>), index: false
      t.references :result, polymorphic: true, type: reference_type_for(:<%= message_table_name %>), index: false
      t.string :tool_call_id, null: false
      t.string :name, null: false
      t.text :thought_signature
      t.string :approval
<% if postgresql? %>
      t.jsonb :arguments, default: {}
<% elsif mysql? %>
      t.json :arguments
<% else %>
      t.json :arguments, default: {}
<% end %>
      t.timestamps
    end
  end

  def normalize_tool_calls
    table = :ruby_llm_tool_calls
    indexes = []
    legacy_message_column = :<%= legacy_tool_call_message_foreign_key %>
<% if postgresql? -%>
    normalize_postgresql_json_columns(table, %i[arguments])
<% end -%>
<% unless mysql? -%>
    normalize_json_defaults(table, arguments: {})
<% end -%>
    if migration_record(table).where(tool_call_id: nil).exists?
      raise 'ruby_llm_tool_calls contains a NULL tool_call_id. Set it before retrying.'
    end

    if legacy_message_column != :message_id && column_exists?(table, legacy_message_column)
      remove_column_foreign_keys(table, legacy_message_column)
      with_upgrade_safety { rename_column table, legacy_message_column, :message_id }
    end
    remove_column_foreign_keys(table, :message_id)
    remove_matching_indexes(table, :message_id)

    if column_exists?(table, :message_type)
      migration_record(table).where(message_type: nil).update_all(message_type: '<%= message_model_name %>')
      with_upgrade_safety { change_column_null table, :message_type, false }
    else
      add_column table, :message_type, :string, null: false, default: '<%= message_model_name %>'
      change_column_default table, :message_type, from: '<%= message_model_name %>', to: nil
    end

    with_upgrade_safety do
      change_table table, bulk: true do |definition|
        definition.string :result_type unless column_exists?(table, :result_type)
        unless column_exists?(table, :result_id)
          definition.column :result_id, reference_type_for(:<%= message_table_name %>)
        end
        definition.text :thought_signature unless column_exists?(table, :thought_signature)
        definition.string :approval unless column_exists?(table, :approval)
      end
    end
    if column_exists?(table, :thought_signature, :string)
      with_upgrade_safety { change_column table, :thought_signature, :text }
    end
    backfill_tool_results

    unless valid_index_exists?(table, %i[message_type message_id])
      indexes << [%i[message_type message_id], {}]
    end
    unless valid_index_exists?(table, %i[result_type result_id])
      indexes << [%i[result_type result_id], {}]
    end
    unless valid_index_exists?(table, :tool_call_id, unique: true)
      deduplicate_tool_call_ids
      remove_matching_indexes(table, :tool_call_id)
      indexes << [:tool_call_id, { unique: true }]
    end
    indexes << [:name, {}] unless valid_index_exists?(table, :name)
    add_upgrade_indexes(table, indexes)
  end

  # Provider tool-call ids are only unique within one request, so legacy data
  # can repeat them across chats. The unique index needs them globally unique;
  # renamed rows keep their result links, which join by primary key.
  def deduplicate_tool_call_ids
    tool_calls = migration_record(:ruby_llm_tool_calls)
    loop do
      duplicated = tool_calls.group(:tool_call_id)
                             .having('COUNT(*) > 1')
                             .limit(BACKFILL_BATCH_SIZE)
                             .pluck(:tool_call_id)
      break if duplicated.empty?

      duplicated.each do |tool_call_id|
        records = tool_calls.where(tool_call_id: tool_call_id)
        keeper = records.minimum(tool_calls.primary_key)
        records.where.not(tool_calls.primary_key => keeper).find_each(batch_size: BACKFILL_BATCH_SIZE) do |record|
          record.update!(tool_call_id: available_tool_call_id(tool_calls, record))
        end
      end
    end
  end

  def available_tool_call_id(tool_calls, record)
    suffix = "-migrated-#{record.id}"
    prefix = record.tool_call_id.to_s.slice(0, 255 - suffix.length)
    candidate = "#{prefix}#{suffix}"
    counter = 0
    while tool_calls.where(tool_call_id: candidate).exists?
      counter += 1
      suffix = "-migrated-#{record.id}-#{counter}"
      candidate = "#{prefix.slice(0, 255 - suffix.length)}#{suffix}"
    end
    candidate
  end

  def backfill_tool_results
    result_column = :<%= legacy_message_tool_call_foreign_key %>
    return unless column_exists?(:<%= message_table_name %>, result_column)

    messages = connection.quote_table_name(:<%= message_table_name %>)
    tool_calls = connection.quote_table_name(:ruby_llm_tool_calls)
    message_id = connection.quote_column_name(connection.primary_key(:<%= message_table_name %>))
    tool_call_id = connection.quote_column_name(connection.primary_key(:ruby_llm_tool_calls))
    result_reference = connection.quote_column_name(result_column)
    result_type = connection.quote('<%= message_model_name %>')
    with_upgrade_safety do
<% if mysql? -%>
      execute <<~SQL
        UPDATE #{tool_calls}
        INNER JOIN (
          SELECT #{messages}.#{result_reference} AS matched_tool_call_id,
                 MIN(#{messages}.#{message_id}) AS matched_result_id
            FROM #{messages}
           WHERE #{messages}.#{result_reference} IS NOT NULL
           GROUP BY #{messages}.#{result_reference}
        ) matches ON matches.matched_tool_call_id = #{tool_calls}.#{tool_call_id}
           SET #{tool_calls}.result_id = matches.matched_result_id,
               #{tool_calls}.result_type = #{result_type}
      SQL
<% elsif postgresql? -%>
      execute <<~SQL
        UPDATE #{tool_calls}
           SET result_id = matches.matched_result_id,
               result_type = #{result_type}
          FROM (
            SELECT #{messages}.#{result_reference} AS matched_tool_call_id,
                   MIN(#{messages}.#{message_id}) AS matched_result_id
              FROM #{messages}
             WHERE #{messages}.#{result_reference} IS NOT NULL
             GROUP BY #{messages}.#{result_reference}
          ) matches
         WHERE matches.matched_tool_call_id = #{tool_calls}.#{tool_call_id}
      SQL
<% else -%>
      execute <<~SQL
        UPDATE #{tool_calls}
           SET result_id = (
                 SELECT #{messages}.#{message_id}
                   FROM #{messages}
                  WHERE #{messages}.#{result_reference} = #{tool_calls}.#{tool_call_id}
                  ORDER BY #{messages}.#{message_id}
                  LIMIT 1
               ),
               result_type = #{result_type}
         WHERE EXISTS (
                 SELECT 1
                   FROM #{messages}
                  WHERE #{messages}.#{result_reference} = #{tool_calls}.#{tool_call_id}
               )
      SQL
<% end -%>
    end

    remove_column_foreign_keys(:<%= message_table_name %>, result_column)
    remove_matching_indexes(:<%= message_table_name %>, result_column)
    with_upgrade_safety { remove_column :<%= message_table_name %>, result_column }
  end

  def move_batches
    source = :<%= legacy_batch_table_name %>
    if source != :ruby_llm_batches && table_exists?(source) && !legacy_batch_table?(source)
<% if legacy_batch_explicit? -%>
      raise "#{source} does not look like a RubyLLM batch table. Check the batch: mapping."
<% else -%>
      create_batches unless table_exists?(:ruby_llm_batches)
      source = :ruby_llm_batches
<% end -%>
    end

    move_table(source, :ruby_llm_batches) { create_batches }
    add_column :ruby_llm_batches, :chat_type, :string unless column_exists?(:ruby_llm_batches, :chat_type)
    add_column :ruby_llm_batches, :batch_protocol, :string unless column_exists?(:ruby_llm_batches, :batch_protocol)
<% if postgresql? -%>
    add_column :ruby_llm_batches, :request_counts, :jsonb unless column_exists?(:ruby_llm_batches, :request_counts)
    normalize_postgresql_json_columns(:ruby_llm_batches, %i[chat_ids request_counts])
<% else -%>
    add_column :ruby_llm_batches, :request_counts, :json unless column_exists?(:ruby_llm_batches, :request_counts)
<% end -%>
<% unless mysql? -%>
    normalize_json_defaults(:ruby_llm_batches, chat_ids: [])
<% end -%>
    migration_record(:ruby_llm_batches).where(chat_type: nil).update_all(chat_type: '<%= chat_model_name %>')
    ensure_unique_index(:ruby_llm_batches, %i[provider provider_batch_id])
    add_upgrade_index :ruby_llm_batches, :status unless valid_index_exists?(:ruby_llm_batches, :status)
  end

  def legacy_batch_table?(table)
    return false unless table_exists?(table)

    %i[provider_batch_id provider status completed chat_ids created_at updated_at].all? do |column|
      column_exists?(table, column)
    end
  end

  def create_batches
    create_table :ruby_llm_batches do |t|
      t.string :provider_batch_id, null: false
      t.string :provider, null: false
      t.string :status
      t.boolean :completed, null: false, default: false
      t.string :chat_type
      t.string :batch_protocol
<% if postgresql? %>
      t.jsonb :chat_ids, default: []
      t.jsonb :request_counts
<% elsif mysql? %>
      t.json :chat_ids
      t.json :request_counts
<% else %>
      t.json :chat_ids, default: []
      t.json :request_counts
<% end %>
      t.timestamps
    end
  end

  def create_usage_entries
    return if table_exists?(:ruby_llm_usages)

    create_table :ruby_llm_usages do |t|
      t.references :chat, polymorphic: true, null: false,
                          type: reference_type_for(:<%= chat_table_name %>), index: false
      t.references :message, polymorphic: true,
                             type: reference_type_for(:<%= message_table_name %>), index: false
      t.string :operation, null: false
      t.string :provider, null: false
      t.string :model, null: false
      t.string :status, null: false
      t.integer :input_tokens
      t.integer :output_tokens
      t.integer :cache_read_tokens
      t.integer :cache_write_tokens
      t.integer :thinking_tokens
      t.decimal :input_cost, precision: 16, scale: 10
      t.decimal :output_cost, precision: 16, scale: 10
      t.decimal :cache_read_cost, precision: 16, scale: 10
      t.decimal :cache_write_cost, precision: 16, scale: 10
      t.decimal :thinking_cost, precision: 16, scale: 10
      t.decimal :total_cost, precision: 16, scale: 10
      t.timestamps
      t.check_constraint "operation IN (<%= usage_operations_sql %>)"
      t.check_constraint "status IN (<%= usage_statuses_sql %>)"
    end
  end

  def backfill_usage_entries
    joins, provider, model = usage_identity_sql
    conditions = usage_backfill_conditions(provider, model)
    return if conditions.empty?

    create_usage_progress
    progress = migration_record(USAGE_PROGRESS_TABLE)
    return if progress.where(completed: true).exists?

    candidate = usage_candidate_sql(conditions, joins)

    migration_record(:ruby_llm_usages).transaction do
      with_upgrade_safety { execute usage_insert_sql(candidate, provider, model) }
      progress.insert_all!([{ completed: true }], returning: false)
    end
  end

  def legacy_usage_conditions
    columns = (LEGACY_TOKEN_COLUMNS + %w[cached_tokens cache_creation_tokens total_cost]).uniq
    present = columns.select { |column| column_exists?(:<%= message_table_name %>, column) }
    conditions = present.map { |column| "legacy_messages.#{connection.quote_column_name(column)} IS NOT NULL" }
    return conditions unless column_exists?(:<%= message_table_name %>, :cost_details)

    costs = %w[input output cache_read cache_write thinking total].map do |key|
      "#{legacy_cost_detail(key)} IS NOT NULL"
    end
    conditions << "(#{costs.join(' OR ')})"
  end

  def usage_backfill_conditions(provider, model)
    conditions = legacy_usage_conditions
    return conditions unless column_exists?(:<%= message_table_name %>, :role)

    role = "legacy_messages.#{connection.quote_column_name(:role)}"
    conditions << "(#{role} = 'assistant' AND #{provider} IS NOT NULL AND #{model} IS NOT NULL)"
  end

  def usage_identity_sql(models_table: :ruby_llm_models, chat_model_column: :ruby_llm_model_id)
    joins = []
    identities = []
    models = connection.quote_table_name(models_table) if models_table
    model_primary_key = if models_table
                          connection.quote_column_name(connection.primary_key(models_table))
                        end
    legacy_model_column = :<%= legacy_model_foreign_key %>

    if column_exists?(:<%= message_table_name %>, legacy_model_column)
      column = connection.columns(:<%= message_table_name %>).find do |candidate|
        candidate.name == legacy_model_column.to_s
      end
      if column.type == :string
        identities << [legacy_message_value(:provider), legacy_message_value(legacy_model_column)]
      elsif models_table
        message_model = legacy_message_value(legacy_model_column)
        joins << "LEFT JOIN #{models} legacy_message_models " \
                 "ON #{message_model} = legacy_message_models.#{model_primary_key}"
        identities << [
          "legacy_message_models.#{connection.quote_column_name(:provider)}",
          "legacy_message_models.#{connection.quote_column_name(:model_id)}"
        ]
      end
    end

    if models_table && chat_model_column && column_exists?(:<%= chat_table_name %>, chat_model_column)
      chats = connection.quote_table_name(:<%= chat_table_name %>)
      message_chat = legacy_message_value(:<%= chat_table_name.singularize %>_id)
      chat_id = "legacy_chats.#{connection.quote_column_name(connection.primary_key(:<%= chat_table_name %>))}"
      chat_model = "legacy_chats.#{connection.quote_column_name(chat_model_column)}"
      joins << "LEFT JOIN #{chats} legacy_chats ON #{message_chat} = #{chat_id}"
      joins << "LEFT JOIN #{models} legacy_chat_models " \
               "ON #{chat_model} = legacy_chat_models.#{model_primary_key}"
      identities << [
        "legacy_chat_models.#{connection.quote_column_name(:provider)}",
        "legacy_chat_models.#{connection.quote_column_name(:model_id)}"
      ]
    end

    providers, model_ids = identities.transpose
    [joins.join("\n"), coalesce_sql(providers), coalesce_sql(model_ids)]
  end

  def ensure_usage_identities!(conditions, joins, provider, model)
    candidate = usage_candidate_sql(conditions, joins)
    message_id = "legacy_messages.#{connection.quote_column_name(connection.primary_key(:<%= message_table_name %>))}"
    missing = select_value(<<~SQL)
      SELECT #{message_id}
        #{candidate}
         AND (#{provider} IS NULL OR #{model} IS NULL)
       LIMIT 1
    SQL
    if missing
      raise "Could not determine provider and model for <%= message_table_name %> id #{missing}. " \
            'Set its model reference, or its chat model reference, before retrying.'
    end
    candidate
  end

  def coalesce_sql(values)
    values = Array(values).compact
    return 'NULL' if values.empty?
    return values.first if values.one?

    "COALESCE(#{values.join(', ')})"
  end

  def usage_candidate_sql(conditions, joins)
    messages = connection.quote_table_name(:<%= message_table_name %>)
    message_id = legacy_message_value(connection.primary_key(:<%= message_table_name %>))
    message_type = connection.quote('<%= message_model_name %>')
    existing = if table_exists?(:ruby_llm_usages)
                 usages = connection.quote_table_name(:ruby_llm_usages)
                 <<~SQL
                   AND NOT EXISTS (
                     SELECT 1
                       FROM #{usages} existing_usages
                      WHERE existing_usages.message_type = #{message_type}
                        AND existing_usages.message_id = #{message_id}
                        AND existing_usages.operation = 'chat'
                        AND existing_usages.status = 'succeeded'
                   )
                 SQL
               end
    <<~SQL
      FROM #{messages} legacy_messages
      #{joins.rstrip}
      WHERE (#{conditions.join(' OR ')})
      #{existing&.rstrip}
    SQL
  end

  def usage_insert_sql(candidate, provider, model)
    usages = connection.quote_table_name(:ruby_llm_usages)
    columns = %i[
      chat_type chat_id message_type message_id operation provider model status
      input_tokens output_tokens cache_read_tokens cache_write_tokens thinking_tokens
      input_cost output_cost cache_read_cost cache_write_cost thinking_cost total_cost
      created_at updated_at
    ].map { |column| connection.quote_column_name(column) }.join(', ')
    total_cost = legacy_total_cost
    values = [
      connection.quote('<%= chat_model_name %>'),
      legacy_message_value(:<%= chat_table_name.singularize %>_id),
      connection.quote('<%= message_model_name %>'),
      legacy_message_value(connection.primary_key(:<%= message_table_name %>)),
      connection.quote('chat'),
      provider,
      model,
      connection.quote('succeeded'),
      *LEGACY_TOKEN_COLUMNS.map { |column| legacy_message_value(column) },
      *%w[input output cache_read cache_write thinking].map { |key| legacy_cost_detail(key) },
      total_cost,
      legacy_message_value(:created_at, fallback: 'CURRENT_TIMESTAMP'),
      legacy_message_value(:updated_at, fallback: 'CURRENT_TIMESTAMP')
    ].join(', ')
    <<~SQL
      INSERT INTO #{usages} (#{columns})
      SELECT #{values}
        #{candidate}
    SQL
  end

  def legacy_message_value(column, fallback: 'NULL')
    return fallback unless column_exists?(:<%= message_table_name %>, column)

    "legacy_messages.#{connection.quote_column_name(column)}"
  end

  def legacy_cost_detail(key)
    return 'NULL' unless column_exists?(:<%= message_table_name %>, :cost_details)

    details = legacy_message_value(:cost_details)
<% if postgresql? -%>
    "NULLIF(#{details}::jsonb ->> '#{key}', '')::numeric"
<% elsif mysql? -%>
    "JSON_UNQUOTE(JSON_EXTRACT(#{details}, '$.#{key}'))"
<% else -%>
    "json_extract(#{details}, '$.#{key}')"
<% end -%>
  end

  def legacy_total_cost
    total = legacy_message_value(:total_cost)
    details = legacy_cost_detail('total')
    return 'NULL' if total == 'NULL' && details == 'NULL'
    return details if total == 'NULL'
    return total if details == 'NULL'

    "COALESCE(#{total}, #{details})"
  end

  def create_usage_progress
    return if table_exists?(USAGE_PROGRESS_TABLE)

    create_table USAGE_PROGRESS_TABLE, id: false do |table|
      table.boolean :completed, null: false
    end
  end

  def normalize_usage_indexes
    indexes = [
      %i[chat_type chat_id],
      %i[message_type message_id],
      :status
    ]
    missing = indexes.reject { |columns| valid_index_exists?(:ruby_llm_usages, columns) }
                     .map { |columns| [columns, {}] }
    add_upgrade_indexes(:ruby_llm_usages, missing)
  end

  def drop_usage_progress
    drop_table USAGE_PROGRESS_TABLE if table_exists?(USAGE_PROGRESS_TABLE)
  end

  def remove_legacy_message_columns
    table = :<%= message_table_name %>
    legacy_model_column = :<%= legacy_model_foreign_key %>
    remove_column_foreign_keys(table, legacy_model_column)
    remove_matching_indexes(table, legacy_model_column)

    candidates = LEGACY_TOKEN_COLUMNS + LEGACY_COST_COLUMNS + [
      legacy_model_column
    ]
    columns = candidates.uniq.select { |column| column_exists?(table, column) }
    with_upgrade_safety { remove_columns table, *columns } unless columns.empty?
  end

  def move_table(source, target)
    if source != target && table_exists?(source)
      if table_exists?(target)
        raise "Both #{source} and #{target} exist. Merge or remove one before running this migration."
      end

      with_upgrade_safety { rename_table source, target }
    elsif !table_exists?(target)
      yield
    end
  end

  def ensure_unique_index(table, columns)
    return if valid_index_exists?(table, columns, unique: true)

    duplicates = migration_record(table).group(*columns).having('COUNT(*) > 1').limit(5).pluck(*columns)
    unless duplicates.empty?
      raise "Cannot add a unique index to #{table} on #{columns.join(', ')}; " \
            "duplicate values include #{duplicates.inspect}. Reconcile them before retrying."
    end

    remove_matching_indexes(table, columns)
    add_upgrade_index table, columns, unique: true
  end

  def ensure_index_method(table, columns, using:)
    return if valid_index_exists?(table, columns, using: using)

    indexes = connection.indexes(table).select { |index| index.columns == Array(columns).map(&:to_s) }
    indexes.each { |index| remove_upgrade_index(table, index.name) }
    add_upgrade_index table, columns, using: using
  end

  def remove_matching_indexes(table, columns)
    names = connection.indexes(table).filter_map do |index|
      index.name if index.columns == Array(columns).map(&:to_s)
    end
    names.each { |name| remove_upgrade_index(table, name) }
  end

  def remove_column_foreign_keys(table, column)
    foreign_keys = connection.foreign_keys(table).select { |key| key.column == column.to_s }
    foreign_keys.each { |key| remove_foreign_key table, key.to_table, column: column }
  end

  def valid_index_exists?(table, columns, unique: nil, using: nil)
    matching = connection.indexes(table).select do |index|
      index.columns == Array(columns).map(&:to_s) &&
        (unique.nil? || index.unique == unique) &&
        (using.nil? || index.using.to_s == using.to_s)
    end
    valid, invalid = matching.partition { |index| !index.respond_to?(:valid?) || index.valid? }
    invalid.each { |index| remove_upgrade_index(table, index.name) }
    valid.any?
  end

  def add_upgrade_index(table, columns, **options)
<% if postgresql? -%>
    options[:algorithm] = :concurrently
<% end -%>
    add_index table, columns, **options
  end

  def add_upgrade_indexes(table, indexes)
    return if indexes.empty?

<% if mysql? -%>
    with_upgrade_safety do
      change_table table, bulk: true do |definition|
        indexes.each { |columns, options| definition.index columns, **options }
      end
    end
<% else -%>
    indexes.each { |columns, options| add_upgrade_index(table, columns, **options) }
<% end -%>
  end

  def remove_upgrade_index(table, name)
    options = { name: name }
<% if postgresql? -%>
    options[:algorithm] = :concurrently
<% end -%>
    remove_index table, **options
  end

  def add_upgrade_foreign_key(table, target, column:)
<% if postgresql? -%>
    add_foreign_key table, target, column: column, validate: false
    validate_foreign_key table, target, column: column
<% elsif mysql? -%>
    connection.disable_referential_integrity do
      add_foreign_key table, target, column: column
    end
<% else -%>
    add_foreign_key table, target, column: column
<% end -%>
  end

  def reference_type_for(table)
    primary_key = connection.primary_key(table)
    column = connection.columns(table).find { |candidate| candidate.name == primary_key }
    raise "Could not determine the primary key type for #{table}" unless column

    return :bigint if column.type == :integer && column.limit == 8

    column.type
  end

  def migration_record(table)
    Class.new(ActiveRecord::Base) do
      self.table_name = table.to_s
      self.inheritance_column = :_type_disabled
    end
  end
end
