<%% questions = <%= chat_model_name.demodulize.underscore %>.pending_questions %>
<div id="<%= chat_variable_name %>_<%%= <%= chat_model_name.demodulize.underscore %>.id %>_questions">
  <%% if questions.any?(&:approval?) %>
    <style>
      <%% questions.select(&:approval?).each do |question| %>
        [id="<%= message_variable_name %>_tool_call_<%%= question.tool_call.id %>"] { display: none; }
      <%% end %>
    </style>
  <%% end %>
  <%% questions.each do |question| %>
    <%%= render "<%= question_view_path %>/question", question: question, <%= chat_model_name.demodulize.underscore %>: <%= chat_model_name.demodulize.underscore %> %>
  <%% end %>
</div>
