<%%# The files every store of the chat sees. Files a store wrote for an owner stay theirs: add them with .or(...where(owner: Current.user)). %>
<%% files = <%= chat_model_name.demodulize.underscore %>.ruby_llm_chat_files.where(owner_id: nil).with_attached_file %>
<%% if files.any? %>
  <section id="<%= chat_variable_name %>_<%%= <%= chat_model_name.demodulize.underscore %>.id %>_files">
    <h2>Files</h2>
    <ul>
      <%% files.each do |file| %>
        <li>
          <%%= link_to file.path, rails_blob_path(file.file, disposition: "attachment") %>
          (<%%= number_to_human_size(file.byte_size) %>)
        </li>
      <%% end %>
    </ul>
  </section>
<%% end %>
