<%% assistant ||= local_assigns[:<%= message_model_name.demodulize.underscore %>] %>
<%% streaming = assistant.content.blank? && assistant.<%= chat_table_name.singularize %>.running? %>
<div id="<%%= dom_id(assistant) %>" class="<%= message_variable_name %>"<%%= " data-streaming" if streaming %>
     data-controller="chat-message" data-action="turbo:morph-element->chat-message#restore"
     style="margin-bottom: 20px; padding: 10px; border-left: 3px solid #28a745;">
  <div style="font-weight: bold; margin-bottom: 5px;">Assistant</div>
  <div id="<%%= dom_id(assistant) %>_<%%= streaming ? "stream" : "content" %>" data-chat-message-target="source" style="white-space: pre-wrap;"><%%= assistant.content %></div>
  <%% if streaming %>
    <div class="thinking" style="color: #666;">Thinking…</div>
    <style>#<%%= dom_id(assistant) %>_stream:not(:empty) ~ .thinking { display: none; }</style>
  <%% end %>
  <div data-chat-message-target="output"></div>
  <%%= render "<%= message_model_name.underscore.pluralize %>/attachments", message: assistant %>
  <div style="font-size: 0.85em; color: #666; margin-top: 5px;">
    <%%= assistant.created_at&.strftime("%I:%M %p") %>
  </div>
</div>
