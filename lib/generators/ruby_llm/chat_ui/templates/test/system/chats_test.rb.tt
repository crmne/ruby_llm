require "application_system_test_case"
require "ruby_llm/test_helper"

class <%= chat_controller_class_name.delete_suffix("Controller") %>Test < ApplicationSystemTestCase
  include RubyLLM::TestHelper

  driven_by :selenium, using: :headless_chrome

  setup do
    @queue_adapter = <%= chat_job_class_name %>.queue_adapter
    <%= chat_job_class_name %>.queue_adapter = :async
  end

  teardown { <%= chat_job_class_name %>.queue_adapter = @queue_adapter }

  test "streaming a reply and showing its cost" do
    stub_replies "Hello from the model", cost: 0.01

    start_chat

    assert_text "Hello from the model"
    assert_text "$0.0100"
  end

  test "stopping a reply keeps what it showed" do
    stub_replies (1..200).map { |word| "word#{word}" }.join(" "), interval: 0.05

    start_chat
    assert_text "word1"
    click_on "Stop"

    assert_no_selector "[data-streaming]", wait: 5
    assert_no_button "Stop"
    assert_text "word1"
    assert_no_text "word200"
  end

  test "answering a message sent right after Stop" do
    stub_replies (1..200).map { |word| "word#{word}" }.join(" "), "Answered after stopping", interval: 0.05

    start_chat
    assert_text "word1"
    click_on "Stop"
    fill_in "<%= message_variable_name %>[content]", with: "One more thing"
    click_on "Send <%= message_table_name.singularize.humanize.downcase %>"

    assert_text "Answered after stopping", wait: 10
  end

  test "keeping what a person is typing when the page refreshes" do
    stub_replies "Hello"

    start_chat
    assert_text "Hello"
    fill_in "<%= message_variable_name %>[content]", with: "Half a thought"
    refresh_page

    assert_field "<%= message_variable_name %>[content]", with: "Half a thought"

    fill_in "<%= message_variable_name %>[content]", with: "For this chat only"
    start_chat
    assert_field "<%= message_variable_name %>[content]", with: ""
  end

  test "keeping every field a person changed when the page refreshes, and sending them" do
    sent = []
    subscriber = ActiveSupport::Notifications.subscribe("start_processing.action_controller") do |event|
      sent << event.payload[:params] if event.payload[:controller] == "<%= message_controller_class_name %>"
    end
    stub_replies "Hello", "Noted"

    with_extra_message_fields do
      start_chat
      choose "Length B"
      assert_text "Hello"
      assert_select "History", options: [ "2 messages" ]
      assert_checked_field "Length B"
      select "Formal", from: "Tone"
      fill_in "Note", with: "Keep it short"
      refresh_page

      assert_equal "Formal", find_field("Tone").value
      assert_field "Note", with: "Keep it short"

      fill_in "<%= message_variable_name %>[content]", with: "Thanks"
      click_on "Send <%= message_table_name.singularize.humanize.downcase %>"
      assert_text "Noted"
      assert_equal "Casual", find_field("Tone").value
      assert_field "Note", with: ""
    end

    assert_equal({ "tone" => "Formal", "note" => "Keep it short", "length" => "b" },
      sent.last["<%= message_variable_name %>"].slice("tone", "note", "length"))
  ensure
    ActiveSupport::Notifications.unsubscribe(subscriber)
  end

  test "showing a sent message before its reply starts" do
    stub_replies "Hello"
    <%= chat_job_class_name %>.queue_adapter = :test

    start_chat
    fill_in "<%= message_variable_name %>[content]", with: "Are you there?"
    click_on "Send <%= message_table_name.singularize.humanize.downcase %>"

    assert_text "Are you there?"
    assert_field "<%= message_variable_name %>[content]", with: ""
  end

  test "showing an error when a reply fails, until the next reply starts" do
    stub_replies RubyLLM::ServerError.new("The provider is down"), "Back again"

    start_chat
    assert_text "The reply failed"
    assert_no_text "Thinking…"

    visit current_path
    assert_text "The reply failed"

    fill_in "<%= message_variable_name %>[content]", with: "Try again"
    click_on "Send <%= message_table_name.singularize.humanize.downcase %>"
    assert_text "Back again"
    assert_no_text "The reply failed"
  end

  test "saying so when the model returns no reply" do
    stub_replies ""

    start_chat

    assert_text "The model returned no reply"
  end

  private

  def refresh_page
    find("h1").click
    page.execute_script("Turbo.visit(location.href, { action: 'replace' })")
    assert_no_selector "html[aria-busy]"
  end

  # Renders the message form with two fields of the app's own, as a model
  # picker or an option would add.
  def with_extra_message_fields
    views = Rails.root.join("tmp/system_test_views")
    form = Rails.root.join("app/views/<%= message_model_name.underscore.pluralize %>/_form.html.erb").read
    fields = <<~'ERB'
      <%%= label_tag :<%= message_variable_name %>_tone, "Tone" %>
      <%%= select_tag "<%= message_variable_name %>[tone]", options_for_select(%w[Casual Formal]) %>
      <%%= label_tag :<%= message_variable_name %>_note, "Note" %>
      <%%= text_field_tag "<%= message_variable_name %>[note]" %>
      <%%= label_tag :<%= message_variable_name %>_history, "History" %>
      <%%= select_tag "<%= message_variable_name %>[history]", options_for_select(["#{<%= chat_variable_name %>.<%= message_table_name %>.count} messages"]) %>
      <%% %w[a b c].each do |length| %>
        <%%= radio_button_tag "<%= message_variable_name %>[length]", length, length == (<%= chat_variable_name %>.<%= message_table_name %>.count == 1 ? "a" : "c") %>
        <%%= label_tag "<%= message_variable_name %>_length_#{length}", "Length #{length.upcase}" %>
      <%% end %>
    ERB
    views.join("<%= message_model_name.underscore.pluralize %>").mkpath
    views.join("<%= message_model_name.underscore.pluralize %>/_form.html.erb").write(form.sub(/do \|form\| %>\n/) { |line| line + fields })
    original = ApplicationController.view_paths
    ApplicationController.prepend_view_path(views)
    yield
  ensure
    ApplicationController.view_paths = original if original
  end

  def start_chat
    visit new_<%= chat_variable_name %>_path
    fill_in "<%= chat_variable_name %>_prompt", with: "Hi"
    click_on "Start new <%= chat_table_name.singularize.humanize.downcase %>"
  end
end
