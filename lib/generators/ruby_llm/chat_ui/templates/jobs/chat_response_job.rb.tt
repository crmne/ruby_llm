class <%= chat_job_class_name %> < ApplicationJob
  discard_on RubyLLM::CancelledError

  def perform(<%= chat_variable_name %>_id)
    <%= chat_variable_name %> = <%= chat_agent_class_name %>.find(<%= chat_variable_name %>_id)
    <%= chat_variable_name %>.update!(reply_error: nil)
    <%= chat_variable_name %>.complete(&:broadcast)
    retry_job wait: 1.minute if <%= chat_variable_name %>.running?
  rescue RubyLLM::CancelledError
    raise
  rescue StandardError => error
    <%= chat_variable_name %>&.update!(reply_error: reply_error_message(error))
    <%= chat_variable_name %>&.broadcast_refresh
    raise
  end

  private

  def reply_error_message(error)
    return "This conversation is too long for the model. Start a new chat." if error.is_a?(RubyLLM::ContextLengthExceededError)

    "The reply failed. Send your message again."
  end
end
