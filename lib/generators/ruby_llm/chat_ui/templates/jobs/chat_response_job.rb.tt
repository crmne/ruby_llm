class <%= chat_job_class_name %> < ApplicationJob
  def perform(<%= chat_variable_name %>_id, content = nil)
    <%= chat_variable_name %> = <%= chat_agent_class_name %>.find(<%= chat_variable_name %>_id)
    <%= chat_variable_name %>.ask_later(content) if content

    <%= chat_variable_name %>.complete do |chunk|
      if chunk.content && !chunk.content.empty?
        <%= message_variable_name %> = <%= chat_variable_name %>.<%= message_table_name %>.last
        <%= message_variable_name %>.broadcast_append_chunk(chunk.content)
      end
    end

    <%= chat_variable_name %>.broadcast_replace_to "<%= chat_variable_name %>_#{<%= chat_variable_name %>.id}",
      target: "<%= chat_variable_name %>_#{<%= chat_variable_name %>.id}_approvals",
      partial: "<%= chat_model_name.underscore.pluralize %>/approvals",
      locals: { <%= chat_model_name.demodulize.underscore %>: <%= chat_variable_name %> }
    <%= chat_variable_name %>.broadcast_replace_to "<%= chat_variable_name %>_#{<%= chat_variable_name %>.id}",
      target: "new_<%= message_variable_name %>",
      partial: "<%= message_model_name.underscore.pluralize %>/form",
      locals: { <%= chat_variable_name %>: <%= chat_variable_name %>, <%= message_variable_name %>: <%= message_model_name %>.new }
  end
end
