<%% arguments = approval.arguments.to_h %>
<%% sandbox = arguments["sandbox"].presence if approval.name == "run_code" %>
<div id="approval_<%%= approval.id %>" class="w-full sm:w-auto my-5 space-y-3 rounded-md px-3 py-2 bg-amber-50 border border-amber-200">
  <div>
    <span class="inline-block rounded px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">
      Approve <%%= approval.name %>?
    </span>
  </div>

  <%% if sandbox %>
    <p><%%= arguments["reason"] %></p>
    <pre class="whitespace-pre-wrap text-gray-700 text-sm overflow-x-auto"><%%= arguments["code"] %></pre>
    <p class="text-sm text-gray-700">Runs in the <strong class="font-medium text-gray-900"><%%= sandbox %></strong> sandbox. <%%= <%= chat_model_name.demodulize.underscore %>.tools[:run_code]&.summary(sandbox) %></p>
  <%% else %>
    <dl class="space-y-2 text-sm">
      <%% arguments.each do |name, value| %>
        <div>
          <dt class="font-medium text-gray-900"><%%= name.to_s.humanize %></dt>
          <dd><pre class="whitespace-pre-wrap text-gray-700 overflow-x-auto"><%%= value.is_a?(String) ? value : value.to_json %></pre></dd>
        </div>
      <%% end %>
    </dl>
  <%% end %>

  <div class="flex flex-col sm:flex-row gap-2">
    <%%= button_to "Approve", <%= chat_variable_name %>_approvals_path(<%= chat_model_name.demodulize.underscore %>),
      params: { tool_call_id: approval.tool_call_id, approved: true },
      class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%%= button_to "Deny", <%= chat_variable_name %>_approvals_path(<%= chat_model_name.demodulize.underscore %>),
      params: { tool_call_id: approval.tool_call_id, approved: false },
      class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium cursor-pointer" %>
  </div>
</div>
