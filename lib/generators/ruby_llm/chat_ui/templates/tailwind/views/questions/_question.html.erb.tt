<%% answers_path = <%= chat_variable_name %>_answers_path(<%= chat_model_name.demodulize.underscore %>) %>
<%% card = "question_#{question.id.parameterize}" %>
<%% single = question.fields.first if question.fields.one? %>
<%% choices = single&.choices&.to_h { |choice| [choice, choice] } %>
<%% choices = { "Yes" => true, "No" => false } if single&.type == "boolean" %>
<%% primary = "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
<%% secondary = "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium cursor-pointer" %>
<div id="<%%= card %>" class="w-full sm:w-auto my-5 space-y-3 rounded-md px-3 py-2 bg-amber-50 border border-amber-200">
  <%% if question.approval? %>
    <%% arguments = question.tool_call.arguments %>
    <%% sandbox = arguments["sandbox"].presence if question.tool_call.name == "run_code" %>
    <div>
      <span class="inline-block rounded px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">
        Approve <%%= question.tool_call.name %>?
      </span>
    </div>

    <%% if sandbox %>
      <p><%%= arguments["reason"] %></p>
      <pre class="whitespace-pre-wrap text-gray-700 text-sm overflow-x-auto"><%%= arguments["code"] %></pre>
      <p class="text-sm text-gray-700">Runs in the <strong class="font-medium text-gray-900"><%%= sandbox %></strong> sandbox. <%%= <%= chat_model_name.demodulize.underscore %>.tools[:run_code]&.summary(sandbox) %></p>
    <%% else %>
      <dl class="space-y-2 text-sm">
        <%% arguments.each do |name, value| %>
          <div>
            <dt class="font-medium text-gray-900"><%%= name.to_s.humanize %></dt>
            <dd><pre class="whitespace-pre-wrap text-gray-700 overflow-x-auto"><%%= value.is_a?(String) ? value : value.to_json %></pre></dd>
          </div>
        <%% end %>
      </dl>
    <%% end %>

    <div class="flex flex-col sm:flex-row gap-2">
      <%%= button_to "Approve", answers_path, params: { question_id: question.id }, class: primary %>
      <%%= button_to "Deny", answers_path, params: { question_id: question.id, decline: true }, class: secondary %>
    </div>
  <%% else %>
    <p class="font-medium text-gray-900"><%%= question.message %></p>

    <%% if question.form? && !choices %>
      <%%= form_with url: answers_path, class: "space-y-3" do |form| %>
        <%%= form.hidden_field :question_id, value: question.id %>
        <%% if question.fields.one? %>
          <%%= form.text_field :answer, value: question.fields.first.default, required: question.fields.first.required?,
            id: "#{card}_answer", "aria-label": question.message, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 w-full" %>
        <%% else %>
          <%% question.fields.each do |field| %>
            <%% field_id = "#{card}_#{field.name.to_s.parameterize(separator: "_")}" %>
            <%% list = field.type == "array" %>
            <div>
              <%%= label_tag field_id, field.title || field.name.to_s.humanize, class: "block text-sm font-medium" %>
              <%% if field.choices %>
                <%%= form.select "answer[#{field.name}]", field.choices, { selected: field.default, include_blank: !field.required? && !list },
                  id: field_id, multiple: list, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-1 w-full" %>
              <%% elsif field.type == "boolean" %>
                <%%= form.check_box "answer[#{field.name}]", { checked: field.default, id: field_id, class: "mt-1" }, "true", "false" %>
              <%% else %>
                <%%= form.text_field "answer[#{field.name}]", value: field.default, required: field.required?, id: field_id,
                  class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-1 w-full" %>
              <%% end %>
            </div>
          <%% end %>
        <%% end %>
        <div class="flex flex-col sm:flex-row gap-2">
          <%%= form.submit "Send", class: primary %>
          <%%= form.button "Decline", name: :decline, value: true, formnovalidate: true, class: secondary %>
        </div>
      <%% end %>
    <%% else %>
      <%% if question.url? %>
        <p class="text-sm [overflow-wrap:anywhere]"><%%= link_to question.url, question.url, target: "_blank", rel: "noopener noreferrer", class: "text-blue-600 hover:underline" %></p>
      <%% end %>
      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2">
        <%% if question.url? %>
          <%%= button_to "Done", answers_path, params: { question_id: question.id }, class: primary %>
        <%% else %>
          <%% choices.each do |label, value| %>
            <%%= button_to label, answers_path, params: { question_id: question.id, answer: value }, class: primary %>
          <%% end %>
        <%% end %>
        <%%= button_to "Decline", answers_path, params: { question_id: question.id, decline: true }, class: secondary %>
      </div>
    <%% end %>
  <%% end %>
</div>
