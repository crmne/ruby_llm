<div class="my-5">
  <%%= form.label :model, "Select AI model:" %>
  <%%= form.select :model,
      @chat_models.map { |model| [model.label, [model.provider, model.id].join(":")] }.unshift([default_model_display_name, nil]),
      { selected: selected },
      class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": form.object.errors[:model].none?, "border-red-400 focus:outline-red-600": form.object.errors[:model].any?}] %>
</div>
