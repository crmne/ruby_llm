<%%# The files every store of the chat sees. Files a store wrote for an owner stay theirs: add them with .or(...where(owner: Current.user)). %>
<%% files = <%= chat_model_name.demodulize.underscore %>.ruby_llm_chat_files.where(owner_id: nil).with_attached_file %>
<%% if files.any? %>
  <section id="<%= chat_variable_name %>_<%%= <%= chat_model_name.demodulize.underscore %>.id %>_files" class="my-5">
    <h2 class="font-bold text-lg mb-2">Files</h2>
    <div class="flex flex-wrap gap-3">
      <%% files.each do |file| %>
        <%%= link_to rails_blob_path(file.file, disposition: "attachment"), class: "inline-flex items-center gap-2 rounded-md px-3 py-2 bg-white border border-gray-200 hover:bg-gray-50 text-sm" do %>
          <span class="font-medium text-blue-600"><%%= file.path %></span>
          <span class="text-gray-600"><%%= number_to_human_size(file.byte_size) %></span>
        <%% end %>
      <%% end %>
    </div>
  </section>
<%% end %>
