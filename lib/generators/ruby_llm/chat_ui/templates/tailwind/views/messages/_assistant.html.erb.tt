<%% assistant ||= local_assigns[:<%= message_model_name.demodulize.underscore %>] %>
<%% streaming = assistant.content.blank? && assistant.<%= chat_table_name.singularize %>.running? %>
<div id="<%= message_variable_name %>_<%%= assistant.id %>" class="w-full sm:w-auto my-5 space-y-3 rounded-md px-3 py-2 bg-green-50"<%%= " data-streaming" if streaming %>
     data-controller="chat-message" data-action="turbo:morph-element->chat-message#restore">
  <div>
    <span class="inline-block rounded px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700">
      Assistant
    </span>
  </div>

  <div id="<%= message_variable_name %>_<%%= assistant.id %>_<%%= streaming ? "stream" : "content" %>" data-chat-message-target="source" class="peer whitespace-pre-wrap"><%%= assistant.content %></div>
  <%% if streaming %>
    <div class="hidden peer-empty:block text-gray-500">Thinking…</div>
  <%% end %>
  <div data-chat-message-target="output" class="space-y-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6 [&_code]:font-mono [&_code]:text-sm [&_pre]:overflow-x-auto [&_pre]:rounded-md [&_pre]:bg-white [&_pre]:p-2 [&_a]:text-blue-600 [&_a]:underline"></div>

  <%%= render "<%= message_model_name.underscore.pluralize %>/attachments", message: assistant %>

  <div>
    <span class="text-sm text-gray-600"><%%= assistant.created_at&.strftime("%I:%M %p") %></span>
  </div>
</div>
