class <%= message_controller_class_name %> < ApplicationController
  before_action :set_<%= chat_variable_name %>

  rescue_from RubyLLM::PendingToolCallsError do
    redirect_to @<%= chat_variable_name %>, notice: "Answer the questions above to continue.", status: :see_other
  end

  def create
    if content || attachments
      @<%= chat_variable_name %>.ask_later(content, with: attachments)
      <%= chat_job_class_name %>.perform_later(@<%= chat_variable_name %>.id)

      respond_to do |format|
        format.turbo_stream
        format.html { redirect_to @<%= chat_variable_name %> }
      end
    else
      @<%= message_variable_name %> = @<%= chat_variable_name %>.<%= message_table_name %>.build
      @<%= message_variable_name %>.errors.add(:content, "can't be blank")
      render "<%= chat_model_name.underscore.pluralize %>/show", status: <%= unprocessable_content_status.inspect %>
    end
  end

  private

  def content
    params.dig(:<%= message_variable_name %>, :content).presence
  end

  def attachments
    Array(params.dig(:<%= message_variable_name %>, :attachments)).grep(ActionDispatch::Http::UploadedFile).presence
  end

  def set_<%= chat_variable_name %>
    @<%= chat_variable_name %> = <%= chat_agent_class_name %>.find(params[:<%= chat_model_name.include?('::') ? chat_model_name.demodulize.underscore : chat_variable_name %>_id])
  end
end
