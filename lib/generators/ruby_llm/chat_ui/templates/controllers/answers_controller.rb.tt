class <%= answer_controller_class_name %> < ApplicationController
  before_action :set_<%= chat_variable_name %>

  rescue_from RubyLLM::ToolCallRunningError do
    redirect_to @<%= chat_variable_name %>, notice: "That tool call is already running."
  end

  def create
    if params[:decline]
      @<%= chat_variable_name %>.decline(params[:question_id])
    else
      @<%= chat_variable_name %>.answer(params[:question_id], params[:answer])
    end
    <%= chat_job_class_name %>.perform_later(@<%= chat_variable_name %>.id)

    respond_to do |format|
      format.turbo_stream
      format.html { redirect_to @<%= chat_variable_name %> }
    end
  rescue ArgumentError => error
    # An answer the question can't take, such as a choice it doesn't offer
    redirect_to @<%= chat_variable_name %>, notice: error.message, status: :see_other
  end

  private

  def set_<%= chat_variable_name %>
    @<%= chat_variable_name %> = <%= chat_agent_class_name %>.find(params[:<%= chat_model_name.include?('::') ? chat_model_name.demodulize.underscore : chat_variable_name %>_id])
  end
end
