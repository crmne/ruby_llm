# frozen_string_literal: true

require 'spec_helper'

RSpec.describe RubyLLM::Models do
  include_context 'with configured RubyLLM'

<% if dynamic_models? -%>
  it 'allows provider model ids that are missing from the registry' do
    expect(RubyLLM::Providers::<%= class_name %>.assume_models_exist?).to be(true)
  end
<% else -%>
  it 'expects generated providers to add registry metadata before use' do
    expect(RubyLLM::Providers::<%= class_name %>.assume_models_exist?).to be(false)
  end
<% end -%>
end
