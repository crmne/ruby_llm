# frozen_string_literal: true

require 'ruby_llm'
require 'zeitwerk'
require_relative '<%= slug %>/version'

loader = Zeitwerk::Loader.new
loader.tag = '<%= gem_name %>'
loader.inflector.inflect(
  '<%= slug %>' => '<%= class_name %>'
)
loader.push_dir(File.expand_path('providers', __dir__), namespace: RubyLLM::Providers)
loader.setup

RubyLLM::Provider.register :<%= slug %>, RubyLLM::Providers::<%= class_name %>
