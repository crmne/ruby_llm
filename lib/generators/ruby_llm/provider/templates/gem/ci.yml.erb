name: CI

on:
  pull_request:
    branches: ["main"]
  push:
    branches: ["main"]

permissions:
  contents: read

jobs:
  test:
    name: Ruby ${{ matrix.ruby-version }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        ruby-version: ["3.1", "3.2", "3.3", "3.4", "4.0"]
    steps:
      - uses: actions/checkout@v6

      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: ${{ matrix.ruby-version }}
          bundler-cache: true

      - run: bundle exec rake
        if: matrix.ruby-version != '3.1'

      - run: bundle exec rake rubocop flay spec
        if: matrix.ruby-version == '3.1'

  appraisal:
    name: ${{ matrix.appraisal }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        appraisal: ["ruby-llm-latest", "ruby-llm-main"]
    steps:
      - uses: actions/checkout@v6

      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: "3.4"
          bundler-cache: true

      - run: bundle exec appraisal generate
      - run: bundle exec appraisal ${{ matrix.appraisal }} bundle install
      - run: bundle exec appraisal ${{ matrix.appraisal }} bundle exec rake
