# frozen_string_literal: true

source 'lib/**/*.rb'

component :provider,
          in: %w[
            lib/ruby_llm/providers/<%= slug %>.rb
            lib/ruby_llm/providers/<%= slug %>/**/*.rb
          ],
          namespace: 'RubyLLM::Providers::<%= class_name %>'

provider.cannot_reference_constants 'RSpec', 'WebMock', 'VCR'

preset :ruby_conventions
